# Django
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,seu-dominio.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://seu-dominio.com

# Postgres
POSTGRES_DB=disparo_db
POSTGRES_USER=disparo_user
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_HOST=disparo_postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=disparo_redis
REDIS_PORT=6379

# Celery
CELERY_TIMEZONE=America/Sao_Paulo
CELERY_CONCURRENCY=2
CELERY_RESULT_BACKEND=django-db

# Gunicorn
GUNICORN_WORKERS=3

# Evolution API
EVOLUTION_API_URL=http://disparo_evolution:8080
EVOLUTION_INSTANCE_NAME=pub_feedback
AUTHENTICATION_TYPE=apikey
EVOLUTION_API_KEY=sua_api_key_aqui
EVOLUTION_WEBHOOK_URL=http://disparo_django:8000/envios/webhook/whatsapp/
WEBHOOK_GLOBAL_ENABLED=false
WEBHOOK_GLOBAL_URL=
WEBHOOK_GLOBAL_WEBHOOK_BY_EVENTS=false

# Database (Evolution API)
DATABASE_ENABLED=true
DATABASE_CONNECTION_CLIENT_NAME=evolution_api
DATABASE_PROVIDER=postgresql

# Cache
CACHE_REDIS_ENABLED=true
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_LOCAL_ENABLED=false

# Webhook retry/config
WEBHOOK_REQUEST_TIMEOUT_MS=60000
WEBHOOK_RETRY_MAX_ATTEMPTS=10
WEBHOOK_RETRY_INITIAL_DELAY_SECONDS=5
WEBHOOK_RETRY_USE_EXPONENTIAL_BACKOFF=true
WEBHOOK_RETRY_MAX_DELAY_SECONDS=300
WEBHOOK_RETRY_JITTER_FACTOR=0.2
WEBHOOK_RETRY_NON_RETRYABLE_STATUS_CODES=400,401,403,404,422
WEBHOOK_EVENTS_QRCODE_UPDATED=true
WEBHOOK_EVENTS_MESSAGES_UPDATE=true
WEBHOOK_EVENTS_SEND_MESSAGE_UPDATE=true
WEBHOOK_EVENTS_CONNECTION_UPDATE=true

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=sua_senha_de_app_aqui

# Diversos
OPT_OUT_TOKEN_EXPIRY_DAYS=30
WAIT_TIMEOUT_SECONDS=60
WAIT_RETRY_INTERVAL=2
ENVIRONMENT=development
SENTRY_DSN=
DB_CONN_MAX_AGE=600
DB_CONNECT_TIMEOUT=5

# Django secret key
SECRET_KEY=troque_por_uma_chave_secreta_segura

# Domínio público
PUBLIC_BASE_URL=http://seu-dominio.com
